 "open_classifications": [
  {
   "unit": "phase",
   "reason": "119 files: dynamics solvers (SIM), QNode/gradient/framework bridges (QNODE), NQS/VQE/QNN/ansatz groups (LEARN); split per file at stage 0."
  },
  {
   "unit": "bridge",
   "reason": "Generic Kuramoto-XY Hamiltonian (CORE) next to Paper-27 constants and SCPN adapters (RESEARCH); QSP-04 separates them."
  },
  {
   "unit": "kuramoto_core",
   "reason": "Placed in simulation because it imports phase at module level; could belong to CORE after QSP-03/QSP-04."
  },
  {
   "unit": "hardware",
   "reason": "hardware/classical.py (classical reference solver) belongs to SIM per architecture section 4; QSP-07 moves it."
  },
  {
   "unit": "qpu_compute_types",
   "reason": "Contract-only types: HAL or CONTRACTS nucleus (QSP-05)."
  },
  {
   "unit": "stable_core",
   "reason": "Durable v1 contract: CORE or CONTRACTS (QSP-05, QSP-08)."
  },
  {
   "unit": "attested_result_pack",
   "reason": "Result-pack attestation: BENCH today; overlaps HAL result packs and the QPU-RESULT-PACK tool."
  },
  {
   "unit": "public_api_stability",
   "reason": "Governance catalogue mapped to CONTRACTS; may stay in the umbrella as a workbench-wide policy."
  },
  {
   "unit": "studio_workspace",
   "reason": "New unit after the planning snapshot (Quantum Studio work); mapped to STUDIO, confirm with the Studio owner."
  }
 ],
