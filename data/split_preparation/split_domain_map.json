 "open_classifications": [
  {
   "unit": "phase",
   "reason": "119 files: dynamics solvers (SIM), QNode/gradient/framework bridges (QNODE), NQS/VQE/QNN/ansatz groups (LEARN); split per file at stage 0.",
   "decision": "Owner 2026-09-30 accepted the recommendation: split per file (split_units.phase): 72 framework-bridge and QNode/gradient/audit files -> QNODE; 24 QNN/NQS/VQE/ansatz and training/coupling-learning files -> LEARN; 23 dynamics-solver and synchronisation-objective files incl. __init__ -> SIM. Owner QD17 2026-09-30 approved the pure cross-target phase/__init__.py compatibility facade as workbench-umbrella; independent boundary review accepted source SHA-256 cce90723ca60ca49a00e01ecbd1896fce3be82ba27216e1a817ef1b425852270. Remaining 22 SIM, 72 QNODE and 24 LEARN leaf files retain their approved owners; actual facade dependencies remain visible."
  },
  {
   "unit": "bridge",
   "reason": "Generic Kuramoto-XY Hamiltonian (CORE) next to Paper-27 constants and SCPN adapters (RESEARCH); the generic-hamiltonian-separation work separates them.",
   "decision": "Owner 2026-09-30 accepted: stays CORE for now; the generic-hamiltonian-separation work separates the generic Hamiltonian (CORE) from Paper-27 constants and SCPN adapters (RESEARCH)."
  },
  {
   "unit": "kuramoto_core",
   "reason": "Placed in simulation because it imports phase at module level; could belong to CORE after the lazy-subpackage-exports and generic-hamiltonian-separation work.",
   "decision": "Owner 2026-09-30 accepted: SIM; re-examine for CORE after the lazy-subpackage-exports and generic-hamiltonian-separation work."
  },
  {
   "unit": "hardware",
   "reason": "hardware/classical.py (classical reference solver) belongs to SIM per architecture section 4; the hardware-isolation work moves it.",
   "decision": "Owner 2026-09-30 accepted: HAL; hardware/classical.py moves to SIM in the hardware-isolation work."
  },
  {
   "unit": "qpu_compute_types",
   "reason": "Contract-only types: HAL or CONTRACTS nucleus (the shared-contract-nucleus work).",
   "decision": "Owner 2026-09-30 accepted: HAL for now; HAL vs CONTRACTS decided in the shared-contract-nucleus work."
  },
  {
   "unit": "stable_core",
   "reason": "Durable v1 contract: CORE or CONTRACTS (the shared-contract-nucleus and domain-public-api-freeze work).",
   "decision": "Owner 2026-09-30 accepted: CORE for now; CORE vs CONTRACTS decided in the shared-contract-nucleus and domain-public-api-freeze work."
  },
  {
   "unit": "attested_result_pack",
   "reason": "Result-pack attestation: BENCH today; overlaps HAL result packs and the QPU-RESULT-PACK tool.",
   "decision": "Owner 2026-09-30 accepted: BENCH; overlap with HAL result packs and the QPU-RESULT-PACK tool revisited in the hardware-isolation work."
  },
  {
   "unit": "public_api_stability",
   "reason": "Governance catalogue mapped to CONTRACTS; may stay in the umbrella as a workbench-wide policy.",
   "decision": "Owner 2026-09-30 accepted: CONTRACTS; umbrella alternative revisited in the domain-public-api-freeze work."
  },
  {
   "unit": "studio_workspace",
   "reason": "New unit after the planning snapshot (Quantum Studio work); mapped to STUDIO, confirm with the Studio owner.",
   "decision": "Owner 2026-09-30 accepted: STUDIO (Studio owner informed)."
  },
  {
   "unit": "scientific_design",
   "reason": "Immutable NumPy scientific design, units and objective declarations; no simulation, Studio or backend import.",
   "decision": "Current source responsibility retained for the approved scientific-input/model-convention work. No generic Hamiltonian extraction, shared-contract nucleus or repository split is implied."
  },
  {
   "unit": "kuramoto_model_conventions",
   "reason": "Model/solver-specific phase and quantum evolution conventions and original-owner provenance; finite, delayed, noisy and reduced simulation interpretations remain distinct.",
   "decision": "Current source responsibility retained for the approved scientific-input/model-convention work. No generic Hamiltonian extraction, shared-contract nucleus or repository split is implied."
  },
  {
   "unit": "scientific_problem_parameters",
   "reason": "Original problem/design to Studio ParameterSpec and canonical-identity adapter; the simulation factory consumes problem/design directly and imports no Studio companion.",
   "decision": "Current source responsibility retained for the approved scientific-input/model-convention work. No generic Hamiltonian extraction, shared-contract nucleus or repository split is implied."
  }
 ],
